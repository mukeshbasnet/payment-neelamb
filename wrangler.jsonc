{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "secure-payment-selector",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-03",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "PAYMENT_STORE",
				"class_name": "PaymentStore",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PaymentStore"],
		},
	],
	"vars": {
		"PAYMENT_CURRENCY": "NPR",
		"PAYMENT_EXPIRY_MINUTES": "30",
		"CITIZENS_BANK_QR_IMAGE": "/payment-qr/citizens-bank.jpg",
		"ESEWA_QR_IMAGE": "/payment-qr/esewa.jpg",
		"NEPAL_BANK_QR_IMAGE": "/payment-qr/nepal-bank.jpg",
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01,
		},
	},
}
